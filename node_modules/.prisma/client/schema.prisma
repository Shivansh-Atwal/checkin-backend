generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  passwordHash         String
  fullName             String
  roleId               String
  isDisabled           Boolean          @default(false)
  hasCustomPermissions Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  auditLogs            AuditLog[]
  loginHistory         LoginHistory[]
  role                 Role             @relation(fields: [roleId], references: [id])
  userPermissions      UserPermission[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  roles           RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  loginTime DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// SYNC & OFFLINE-FIRST MODELS
// -----------------------------------------

model Device {
  id         String   @id @default(uuid())
  deviceId   String   @unique
  deviceName String?
  appVersion String?
  platform   String?
  status     String   @default("ACTIVE") // ACTIVE, REVOKED
  lastSync   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operations SyncOperation[]
}

model SyncOperation {
  id            String   @id @default(uuid())
  operationId   String   @unique
  deviceId      String
  userId        String?
  hotelId       String?
  entityType    String
  entityId      String
  operationType String // INSERT, UPDATE, DELETE
  payload       Json
  version       Int      @default(1)
  retryCount    Int      @default(0)
  status        String   @default("PENDING") // PENDING, SUCCESS, CONFLICT, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId])
  @@index([status])
  @@index([entityType, entityId])
}

model ConflictLog {
  id              String   @id @default(uuid())
  operationId     String   @unique
  deviceId        String
  entityType      String
  entityId        String
  clientVersion   Int
  serverVersion   Int
  clientPayload   Json
  serverPayload   Json
  resolved        Boolean  @default(false)
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RegistrationMapping {
  id                 String   @id @default(uuid())
  tempRegistrationId String   @unique
  realRegistrationId String   @unique
  deviceId           String
  createdAt          DateTime @default(now())
}

// -----------------------------------------
// CORE BUSINESS ENTITIES
// -----------------------------------------

model Room {
  id         String @id @default(uuid())
  roomNumber String @unique
  capacity   Int
  status     String @default("AVAILABLE") // Re-added status to align with RoomService requirements

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  checkIns  CheckIn[]

  @@index([deletedAt])
  @@index([status])
}

model Customer {
  id              String    @id @default(uuid())
  fullName        String
  mobileNumber    String    @unique
  alternateNumber String?
  email           String?
  dob             DateTime?
  gender          String?
  address         String?
  city            String?
  state           String?
  country         String?
  pincode         String?

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  checkIns  CheckIn[]
  documents CustomerDocument[]

  @@index([deletedAt])
  @@index([mobileNumber])
}

model CustomerDocument {
  id               String  @id @default(uuid())
  customerId       String
  idType           String
  idNumber         String
  frontImageUrl    String?
  backImageUrl     String?
  customerPhotoUrl String?

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String   @id @default(uuid())
  bookingNumber      String   @unique
  customerId         String
  checkInDate        DateTime
  checkOutDate       DateTime
  numberOfGuests     Int
  roomId             String
  advancePayment     Float    @default(0)
  price              Float    @default(0)
  status             String
  notes              String?
  registrationNumber String?
  extraBedPrice      Float    @default(0)
  extraBedsCount     Int      @default(0)

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
  room          Room      @relation(fields: [roomId], references: [id])
  checkInRecord CheckIn?
  payments      Payment[]

  @@index([deletedAt])
  @@index([customerId])
  @@index([roomId])
  @@index([registrationNumber])
}

model CheckIn {
  id                   String    @id @default(uuid())
  registrationNumber   String?   @unique
  bookingId            String?   @unique
  customerId           String
  roomId               String
  numberOfGuests       Int
  checkInTime          DateTime  @default(now())
  expectedCheckOutDate DateTime
  actualCheckOutTime   DateTime?
  advancePaid          Float     @default(0)
  remainingAmount      Float
  pricePerNight        Float     @default(0)
  status               String
  extraBedPrice        Float     @default(0)
  extraBedsCount       Int       @default(0)

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  room           Room          @relation(fields: [roomId], references: [id])
  checkoutRecord Checkout?
  extraCharges   ExtraCharge[]
  payments       Payment[]

  @@index([deletedAt])
  @@index([customerId])
  @@index([roomId])
  @@index([registrationNumber])
}

model Checkout {
  id                String @id @default(uuid())
  checkInId         String @unique
  roomCharges       Float
  additionalCharges Float  @default(0)
  discount          Float  @default(0)
  taxAmount         Float  @default(0)
  finalAmount       Float
  billingStatus     String

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  invoice   Invoice?
}

model Payment {
  id            String   @id @default(uuid())
  checkInId     String?
  bookingId     String?
  amount        Float
  paymentType   String
  paymentMethod String
  transactionId String?
  paymentDate   DateTime @default(now())
  paymentStatus String
  notes         String?

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id])
}

model Invoice {
  id            String  @id @default(uuid())
  checkoutId    String  @unique
  invoiceNumber String  @unique
  totalAmount   Float
  pdfUrl        String?

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  checkout  Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  recipient String
  message   String
  channel   String
  status    String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id                String   @id @default(uuid())
  userId            String?
  userName          String?
  action            String
  ipAddress         String?
  deviceInformation String?
  details           String?
  timestamp         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])
}

model ExtraCharge {
  id        String @id @default(uuid())
  checkInId String
  itemName  String
  amount    Float
  quantity  Int    @default(1)

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id       String @id @default(uuid())
  name     String @unique
  quantity Int    @default(0)

  version   Int       @default(1)
  deviceId  String?
  hotelId   String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
